SELECT "l"."ID_LEMBRETE_PK" AS "Id", "l"."DESC_LEMBRETE" AS "Descricao", "l"."DATA_LEMBRETE" AS "DataLembrete", "l"."STATUS_LEMBRETE" AS "Status", "l"."ID_PET_FK" AS "PetId"&#xD;
